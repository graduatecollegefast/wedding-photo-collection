# Copy to .env for local development (netlify dev). Never commit real values.
# In production these live ONLY in Netlify > Site configuration > Environment variables.

# Airtable (Personal Access Token scoped to this base: data.records:read, data.records:write)
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_EVENTS_TABLE_ID=
AIRTABLE_UPLOADS_TABLE_ID=

# Cloudinary (API secret stays server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dashboard access. Generate the hash with: npm run hash-password -- "your password"
DASHBOARD_PASSWORD_HASH=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The event the couple dashboard belongs to (Event Slug in Airtable)
EVENT_SLUG=

# Optional tuning (defaults shown)
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=100
# EVENT_TIMEZONE=America/Chicago
# Browser-side: simultaneous uploads per guest (build-time variable)
# VITE_UPLOAD_CONCURRENCY=3
